APTOS_MAINNET_EXECUTION_ENABLED=false
# 安全边界固定为 127.0.0.1；其他值会拒绝启动。
APTOS_WALLET_HOST=127.0.0.1
APTOS_WALLET_API_PORT=48271
# 只能填写 http://127.0.0.1:<本机端口>，不能填写域名、远程 IP 或代理路径。
APTOS_WALLET_WEB_ORIGIN=http://127.0.0.1:48272
APTOS_WALLET_DB_PATH=data/aptos-wallet.sqlite
# Optional custom Mainnet endpoints:
# APTOS_FULLNODE_URL=
# APTOS_INDEXER_URL=
