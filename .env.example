# Copy this file to .env. Never commit .env.
WEEX_API_KEY=
WEEX_API_SECRET=
WEEX_API_PASSPHRASE=

# demo is the safe default. live uses the real WEEX contract account.
WEEX_DEFAULT_MODE=demo

# A live mutation requires this flag plus --execute and an exact confirmation.
WEEX_LIVE_TRADING_ENABLED=false

WEEX_TIMEOUT_MS=15000
WEEX_ENABLE_RATE_LIMIT=true

# Optional standard proxy variables are honored by CCXT requests.
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
