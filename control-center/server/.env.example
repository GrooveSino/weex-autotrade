FLEET_CONTROL_ADAPTER=mock
FLEET_STORAGE=memory
FLEET_SEED_DEMO_DATA=true
FLEET_MOCK_TICK_SECONDS=2.4
FLEET_WEEX_POLL_SECONDS=15
FLEET_WEEX_REQUEST_TIMEOUT_MS=5000
FLEET_WEEX_HISTORY_LOOKBACK_DAYS=365
FLEET_WEEX_HISTORY_PAGES_PER_POLL=1
FLEET_MAX_PARALLEL_POLLS=12
FLEET_ACCOUNT_POLL_TIMEOUT_SECONDS=10
FLEET_MOCK_CYCLE_TOTAL_QUOTE=20
FLEET_BETA_RATIO_URL=http://127.0.0.1:5888/api/v1/hedge-ratio
FLEET_BETA_RATIO_TIMEOUT_SECONDS=3
FLEET_BETA_REFRESH_SECONDS=10
FLEET_BETA_BACKGROUND_REFRESH_ENABLED=true

# For a remote Beta service, set its URL in your untracked .env file.

# Read-only WEEX telemetry. This never submits orders.
# FLEET_CONTROL_ADAPTER=weex-readonly
# FLEET_SEED_DEMO_DATA=false

# SQLite requires both values. Never commit the real master key.
# FLEET_STORAGE=sqlite
# FLEET_DB_PATH=server/data/fleet-control.db
# FLEET_MASTER_KEY=
