{
  "name": "weex-fleet-control-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:executor": "FLEET_EXECUTOR_SOCKET=run/weex-fleet-executor.sock PYTHONPATH=server/src uv run --project server python -m fleet_api.executor_main",
    "dev:api": "FLEET_EXECUTOR_SOCKET=run/weex-fleet-executor.sock uv run --project server uvicorn --app-dir server/src fleet_api.api_proxy:app --host 127.0.0.1 --port 8000",
    "build": "tsc -b && vite build",
    "lint": "eslint src vite.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "^5.9.3",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript-eslint": "latest"
  }
}
